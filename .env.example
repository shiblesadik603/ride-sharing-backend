# ==========================================================================
# Copy to .env and fill in real values. Never commit the actual .env file.
# ==========================================================================

NODE_ENV=development
# Avoid 5000 on macOS — it's claimed by AirPlay Receiver by default.
PORT=4000

# PostgreSQL connection string. Running via `docker compose up`? This is
# overridden there to point at the `postgres` service automatically — this
# value is only used for `npm run dev` against a locally installed
# Postgres, or a hosted instance (Railway/Render/Neon/RDS).
#
# Left at Prisma's default pool size here (num_cpus * 2 + 1) since local
# dev and this project's demo scale don't need tuning — but in production,
# size it deliberately via query params, e.g.:
#   ...ride_sharing?schema=public&connection_limit=10&pool_timeout=10
# `connection_limit` should be set with the target Postgres instance's own
# max_connections in mind (shared across every app/worker replica, not
# per-replica), and multiplied out across however many replicas run
# concurrently — an unset limit on enough replicas is how you exhaust a
# managed Postgres instance's connection cap without ever seeing a single
# slow query. `pool_timeout` (seconds Prisma waits for a free connection
# before giving up) is what turns pool exhaustion into a clean 503 from
# this API (see error.middleware.js's P2024 handling) instead of a
# request hanging indefinitely.
DATABASE_URL="postgresql://user:password@localhost:5432/ride_sharing?schema=public"

# Redis connection string.
REDIS_URL="redis://localhost:6379"

# Generate with: openssl rand -hex 32
# Access and refresh secrets MUST be different — a leaked access token
# should never be usable to mint new refresh tokens.
JWT_ACCESS_SECRET="replace-with-a-64-char-hex-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-64-char-hex-secret"
JWT_REFRESH_EXPIRES_IN="30d"

# Comma-separated list of allowed origins, or "*" for local dev only.
CORS_ORIGIN="*"

# error | warn | info | http | debug
LOG_LEVEL="info"

BCRYPT_SALT_ROUNDS=12

# Frontend base URL — used to build links inside verification/reset emails.
CLIENT_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials.
# Backend only verifies ID tokens minted by the client SDK — no client
# secret or redirect URI needed server-side.
GOOGLE_CLIENT_ID=

# Optional in development: unset means email.service logs the rendered
# email to the console instead of sending it, so auth flows are runnable
# without a mail provider account.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ride Sharing <no-reply@ridesharing.local>"

# Optional: unset means ride distance/duration/ETA fall back to a
# Haversine straight-line estimate instead of calling Google Directions.
GOOGLE_MAPS_API_KEY=

# Optional: unset means CARD ride payments and wallet top-ups are
# rejected with a clear "not configured" error; WALLET and CASH payments
# work fully without Stripe. Get both from the Stripe Dashboard (test
# mode keys are fine for local dev) — the webhook secret comes from
# `stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe`
# when testing locally, or the endpoint's settings page in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set to "false" on the API service only when running background jobs as
# a separate `worker` process (see docker-compose.yml) — leave "true" (or
# unset) for `npm run dev` and any single-service deployment.
ENABLE_JOBS=true

# --------------------------------------------------------------------------
# Added in later phases (not required yet):
#   AWS_S3_BUCKET / AWS_ACCESS_KEY_ID / ...   — document/avatar uploads
# --------------------------------------------------------------------------
