NODE_ENV=test
PORT=4001

# Separate database — tests never touch the dev DB. Migrated via
# `prisma migrate deploy` (not `migrate dev`), the correct non-interactive
# command for an environment that only applies existing migrations.
DATABASE_URL="postgresql://smsadik@localhost:5432/ride_sharing_test?schema=public"

# Separate logical Redis DB (index 1, vs dev's default index 0) — keeps
# test job/geo state from colliding with whatever's in the dev Redis.
REDIS_URL="redis://localhost:6379/1"

JWT_ACCESS_SECRET="test-only-access-secret-not-for-real-use-00000000"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="test-only-refresh-secret-not-for-real-use-00000000"
JWT_REFRESH_EXPIRES_IN="30d"

CORS_ORIGIN="*"
LOG_LEVEL="error"

BCRYPT_SALT_ROUNDS=10
CLIENT_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ride Sharing <no-reply@ridesharing.local>"
GOOGLE_MAPS_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
